<figure class="identity-figure">
  <div class="figure-grid" aria-hidden="true"></div>
  <div class="figure-top">
    <span class="eyebrow">Identity, made verifiable</span>
    <span class="example-label">Illustrative example</span>
  </div>
  <div class="identity-card">
    <div class="card-topline">
      <span class="mono">ANS / AGENT IDENTITY</span>
      <span class="verified-dot">●</span>
    </div>
    <div class="agent-glyph" aria-hidden="true">
      <span>●</span>
      <span>●</span>
    </div>
    <h2>payments.example.com</h2>
    <p class="mono agent-name">ans://v1.0.0.payments.example.com</p>
    <dl class="identity-checks">
      <div>
        <dt>
          <span aria-hidden="true">✓</span> Identity
        </dt>
        <dd>Bound to a domain</dd>
      </div>
      <div>
        <dt>
          <span aria-hidden="true">✓</span> Status
        </dt>
        <dd>Registration is current</dd>
      </div>
      <div>
        <dt>
          <span aria-hidden="true">✓</span> Possession
        </dt>
        <dd>Key holder authenticated</dd>
      </div>
    </dl>
    <div class="card-bottomline">
      <span class="mono">An identity you can check.</span>
      <span aria-hidden="true">↗</span>
    </div>
  </div>
  <figcaption>
    <span class="diagram-node">Domain</span>
    <span class="diagram-line" aria-hidden="true"></span>
    <span class="diagram-node">Transparency log</span>
    <span class="diagram-line" aria-hidden="true"></span>
    <span class="diagram-node">Peer</span>
  </figcaption>
</figure>
