---
import Base from '../layouts/Base.astro';
import IdentityCard from '../components/IdentityCard.astro';
import { url, organization, sdks } from '../data/site';
---

<Base
  title="Verifiable identity for AI agents"
  description="Agent Name Service is an open specification for naming, discovering, and authenticating AI agents. Read the specification, try an implementation, or contribute."
>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> Agent Name Service
      </p>
      <h1>
        Verifiable identity
        <br />
        <em>for AI agents.</em>
      </h1>
      <p class="lead">
        ANS is an open specification for naming, discovering, and authenticating
        AI agents. It connects domain names, certificates, and transparency
        records so peers can verify who they are communicating with.
      </p>
      <div class="actions">
        <a class="button" href={url('docs/')}>
          Read the specification <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={url('for-developers/')}>
          Try an implementation <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={url('community/')}>
          Contribute <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-footnote">
        The published specifications are drafts under active development.
      </p>
    </div>
    <IdentityCard />
  </section>
  <section class="container section section-border">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Implementations</p>
        <h2>Build with ANS.</h2>
      </div>
      <p>
        Run the Registration Authority and Transparency Log locally, inspect a
        registration, and verify its receipt. Use an SDK to bring verification
        into your application.
      </p>
    </div>
    <div class="implementation-intro">
      <div>
        <h3>Reference implementation</h3>
        <p>
          A runnable registration lifecycle, transparency log, and offline
          verifier.
        </p>
      </div>
      <a class="button secondary" href={url('for-developers/')}>
        Get started <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="sdk-grid">
      {sdks.map((sdk) => (
        <a class="resource-card" href={`${organization}/${sdk.repo}`}>
          <span class="eyebrow">
            {sdk.label}
            <span aria-hidden="true">↗</span>
          </span>
          <h3>{sdk.name}</h3>
          <p>{sdk.detail}</p>
          <span class="mono">{sdk.repo}</span>
        </a>
      ))}
    </div>
    <p class="section-note">
      <a href={url('ecosystem/')}>
        Browse implementations, integrations, and their supported scope →
      </a>
    </p>
  </section>
  <section class="community-section">
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Community & governance</p>
          <h2>Participate in the project.</h2>
        </div>
        <p>
          ANS develops through public specifications, code, and decisions. The
          charter adoption date is November 3, 2026.
        </p>
      </div>
      <div class="three-columns principles">
        <article>
          <span class="step-number">GOVERNANCE</span>
          <h3>Technical Steering Committee</h3>
          <p>
            The TSC guides project-wide technical direction, governance, and
            escalated decisions.
          </p>
          <a
            class="text-link"
            href={url('governance/#technical-steering-committee')}
          >
            Meet the TSC <span aria-hidden="true">→</span>
          </a>
        </article>
        <article>
          <span class="step-number">MAINTENANCE</span>
          <h3>Maintainers & reviewers</h3>
          <p>
            Repository teams review changes, maintain implementations, and take
            responsibility for releases.
          </p>
          <a
            class="text-link"
            href={url('governance/#who-maintains-each-repository')}
          >
            Find a repository team <span aria-hidden="true">→</span>
          </a>
        </article>
        <article>
          <span class="step-number">CONTRIBUTION</span>
          <h3>A place to get involved</h3>
          <p>
            Contribute code, improve documentation, test an integration, or help
            review a proposal.
          </p>
          <a class="text-link" href={url('community/')}>
            Start contributing <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>
  <section class="container section closing-note">
    <p>
      ANS establishes identity. Applications still decide what a peer may do.
    </p>
    <a class="text-link" href={url('how-it-works/')}>
      How verification works <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>
