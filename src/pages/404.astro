---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { url } from '../data/site';
---

<Base
  title="Page not found"
  description="Find your way back to the Agent Name Service website."
  noindex
>
  <PageIntro
    eyebrow="404 / Page not found"
    title="Let’s find the right starting point."
    description="This page may have moved. Explore the specification, find a developer guide, or return to the homepage."
  >
    <div class="actions">
      <a class="button" href={url('')}>
        Back to home →
      </a>
      <a class="text-link" href={url('docs/')}>
        Browse the docs →
      </a>
    </div>
  </PageIntro>
</Base>
