---
import Base from './Base.astro';
import PageIntro from '../components/PageIntro.astro';

interface Props {
  frontmatter: {
    title: string;
    eyebrow: string;
    heading: string;
    description: string;
  };
}
const { title, eyebrow, heading, description } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <PageIntro eyebrow={eyebrow} title={heading} description={description} />
  <div class="container content-section">
    <article class="prose">
      <slot />
    </article>
  </div>
</Base>
